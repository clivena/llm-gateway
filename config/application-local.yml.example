# 提交到仓库的模板（不含真实密钥），方便协作方复制成 application-local.yml
# 用法：cp application-local.yml.example application-local.yml 然后填入自己的 key

gateway:
  cache:
    enabled: false          # 上游无 embedding 接口时缓存自动失效，这里显式关掉
  router:
    # model=auto 的候选表。模型名必须与下面 models 一致，否则启动时会直接报错。
    # 只想用固定模型时，把 policy 保持原样、请求里显式传 model 即可绕开这张表。
    policy: COST_FIRST
    candidates:
      - model: deepseek-flash
        tier: CHEAP
        cost-per-1k: 0.0015
        quality-score: 0.72
      - model: deepseek-v4-pro
        tier: STRONG
        cost-per-1k: 0.0080
        quality-score: 0.90

    # 按任务选模型（默认关闭）。开启后 model=auto 的请求会先判任务再查这张表；
    # 请求里显式指定的 model 仍然最优先，不受这里影响。
    # 启动期校验：tasks 不能为空、每个 model 必须在上面 candidates 里、
    #             default-task 必须在这里声明、classifier 只能是 rule / off。
    task-routing:
      enabled: true
      default-task: chat
      classifier: rule       # rule = 本地规则推断；off = 只认请求里的显式 task
      tasks:
        code:      { model: deepseek-v4-pro }   # 写代码/读代码/改 bug → 强模型
        json:      { model: deepseek-flash }
        summarize: { model: deepseek-flash }
        chat:      { model: deepseek-flash }
  providers:
    # name 是**供应商标识**（用于日志与成本归因），不是协议标识 ——
    # 所有 provider 目前都走 OpenAI 兼容协议，所以写真实厂商名即可。
    # 加第二家会自动多出一个适配器（见 ProviderRegistry），无需改代码。
    - name: deepseek
      base-url: https://api.deepseek.com/v1
      api-key: "sk-替换成你自己的key"
      embedding-model: ""
      models:
        - deepseek-flash
        - deepseek-v4-pro
