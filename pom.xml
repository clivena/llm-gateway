<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.llmgw</groupId>
  <artifactId>llm-gateway</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>llm-gateway</name>
  <description>LLM smart gateway: routing, semantic cache, quota, cost ledger</description>

  <properties>
    <java.version>17</java.version>
    <!--
      byte-buddy 必须覆写：Spring Boot 3.3.4 默认管理 1.14.19，
      而本机用 JDK 24 编译运行 —— 1.14.19 无法插桩 JDK 24 的类，
      Mockito 直接报 "Could not modify all classes"（inline mock maker 失效）。
      1.15.11 是本地仓库里第一个能用的版本。
      仅影响测试期（mock 生成），不进运行时依赖。
    -->
    <byte-buddy.version>1.15.11</byte-buddy.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
    </dependency>
    <!-- 成本账本落库：R2DBC 全链路非阻塞，不会把 Netty 事件循环线程占住 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-r2dbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>r2dbc-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- /actuator/prometheus 端点需要这个 registry；缺它时该端点直接 404 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      重试与熔断（F1）。刻意只引这三个模块，不引 resilience4j-spring-boot3：

        ① 该 starter 的用法是注解（@CircuitBreaker(name="...")），要求熔断器名字
           在编译期已知；而本项目的 provider 是 gateway.providers[] 动态配的，
           名字只能在启动期才算出来。注解在这里根本用不上。
        ② 注解模式依赖 AOP 代理，而本项目主链路是返回 Mono/Flux 的方法 ——
           代理 + 响应式的组合是经典坑区（自调用失效、类型被擦成 Object）。
        ③ F2 的故障转移需要按 provider 名查询"下一个候选的熔断器还能不能用"，
           编程式 Registry 能直接拿到那个状态对象，注解模式拿不到。

      因此走编程式：自己建 CircuitBreakerRegistry / RetryRegistry，
      用 CircuitBreakerOperator / RetryOperator 把 Mono/Flux 包起来。
      代价是少一个健康检查端点，已用 /admin/circuit 补上。
    -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
      <version>2.2.0</version>
    </dependency>
    <!-- 提供 CircuitBreakerOperator / RetryOperator（Mono 与 Flux 通用） -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
